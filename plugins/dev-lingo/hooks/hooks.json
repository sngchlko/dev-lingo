{
  "description": "Display English as a native Codex hook notification; return no model context.",
  "hooks": {
    "SessionStart": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "python3 \"${PLUGIN_ROOT}/scripts/dev_lingo.py\" prepare --host codex",
            "timeout": 5,
            "commandWindows": "python -X utf8 -c \"import os,runpy,sys;sys.path.insert(0,os.path.join(os.environ['PLUGIN_ROOT'],'scripts'));runpy.run_path(os.path.join(os.environ['PLUGIN_ROOT'],'scripts','dev_lingo.py'),run_name='__main__')\" prepare --host codex"
          }
        ]
      }
    ],
    "UserPromptSubmit": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "python3 \"${PLUGIN_ROOT}/scripts/dev_lingo.py\" hook --host codex",
            "timeout": 55,
            "commandWindows": "python -X utf8 -c \"import os,runpy,sys;sys.path.insert(0,os.path.join(os.environ['PLUGIN_ROOT'],'scripts'));runpy.run_path(os.path.join(os.environ['PLUGIN_ROOT'],'scripts','dev_lingo.py'),run_name='__main__')\" hook --host codex"
          }
        ]
      }
    ]
  }
}
